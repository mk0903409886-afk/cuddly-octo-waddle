    <script>
        // التنقل بين الصفحات
        document.addEventListener('DOMContentLoaded', function() {
            // الحصول على جميع روابط التنقل
            const navLinks = document.querySelectorAll('.nav-link, .nav-link-btn');
            const pages = document.querySelectorAll('.page-content');
            
            // إضافة حدث النقر لكل رابط
            navLinks.forEach(link => {
                link.addEventListener('click', function(e) {
                    e.preventDefault();
                    
                    // الحصول على الصفحة المستهدفة
                    const targetPage = this.getAttribute('data-page');
                    
                    // إخفاء جميع الصفحات
                    pages.forEach(page => {
                        page.classList.remove('active');
                    });
                    
                    // إظهار الصفحة المستهدفة
                    document.getElementById(targetPage).classList.add('active');
                    
                    // تحديث حالة الروابط النشطة في القائمة
                    document.querySelectorAll('.nav-link').forEach(nav => {
                        nav.classList.remove('active');
                    });
                    
                    // إذا كان الرابط من القائمة الرئيسية
                    if (this.classList.contains('nav-link')) {
                        this.classList.add('active');
                    } else {
                        // إذا كان الرابط من الأزرار في الصفحة الرئيسية
                        document.querySelector(`.nav-link[data-page="${targetPage}"]`).classList.add('active');
                    }
                    
                    // التمرير إلى أعلى الصفحة عند التنقل
                    window.scrollTo({
                        top: 0,
                        behavior: 'smooth'
                    });
                });
            });
            
            // تعيين الصفحة الأولى كنشطة عند التحميل
            document.getElementById('home').classList.add('active');
            document.querySelector('.nav-link[data-page="home"]').classList.add('active');
        });
    </script>
